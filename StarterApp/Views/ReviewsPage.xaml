<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StarterApp.Views.ReviewsPage"
             Title="Reviews">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="{Binding AverageRating, StringFormat='Average Rating: {0:F1} ⭐'}" FontSize="18" FontAttributes="Bold"/>

            <Label Text="Leave a Review" FontSize="16" FontAttributes="Bold"/>
            <Label Text="{Binding Rating, StringFormat='Rating: {0} ⭐'}" HorizontalOptions="Center" FontSize="16"/>
            <Stepper Value="{Binding Rating}" Minimum="1" Maximum="5" Increment="1" HorizontalOptions="Center"/>
            <Label Text="Comment"/>
            <Editor Text="{Binding Comment}" Placeholder="Write your review..." HeightRequest="80"/>
            <Button Text="Submit Review" Command="{Binding SubmitReviewCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White"/>

            <Label Text="All Reviews" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
            <CollectionView ItemsSource="{Binding Reviews}">
                <CollectionView.EmptyView>
                    <Label Text="No reviews yet" TextColor="Gray" HorizontalOptions="Center"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" Padding="15" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Text="{Binding Rating, StringFormat='{0} ⭐'}" FontAttributes="Bold"/>
                                <Label Text="{Binding Comment}" FontSize="13"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
