<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StarterApp.Views.CreateItemPage"
             Title="List an Item">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Border BackgroundColor="#FFEBEE" Stroke="#F44336" StrokeThickness="1" Padding="15" IsVisible="{Binding HasError}">
                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="#D32F2F" FontSize="14" />
            </Border>
            <Label Text="Title" FontAttributes="Bold"/>
            <Entry Text="{Binding Title}" Placeholder="Enter title"/>
            <Label Text="Description" FontAttributes="Bold"/>
            <Editor Text="{Binding Description}" Placeholder="Describe your item" HeightRequest="100"/>
            <Label Text="Daily Rate (£)" FontAttributes="Bold"/>
            <Entry Text="{Binding DailyRateText}" Keyboard="Default" Placeholder="e.g. 10.00"/>
            <Label Text="Category" FontAttributes="Bold"/>
            <Entry Text="{Binding Category}" Placeholder="e.g. Tools, Games"/>
            <Label Text="Location" FontAttributes="Bold"/>
            <Entry Text="{Binding Location}" Placeholder="Your area"/>
            <Button Text="List Item" Command="{Binding CreateItemCommand}" Margin="0,20,0,0"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
